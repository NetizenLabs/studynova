---
import '../../styles/global.css';
import PrintableLayout from '../../layouts/PrintableLayout.astro';

const countdownDays = Array.from({ length: 30 }, (_, i) => 30 - i);
const phaseFor = (day) => {
    if (day >= 22) return 'BUILD';
    if (day >= 15) return 'RETRIEVE';
    if (day >= 8) return 'PAST PAPERS';
    if (day >= 2) return 'REPAIR';
    return 'TAPER';
};
---

<PrintableLayout title="Exam Countdown" filename="studynova-exam-countdown.pdf">

    <!-- Header Area -->
    <div class="mb-3 border-b-2 border-gray-800 pb-3 flex justify-between items-end">
        <div>
            <h1 class="font-['Outfit'] text-4xl font-black text-gray-900 tracking-tight uppercase">Exam Countdown</h1>
            <p class="text-gray-500 text-sm font-medium mt-1">30 DAYS &bull; ONE TARGET AT A TIME</p>
        </div>
        <div class="flex flex-col gap-2 w-64">
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-gray-600 uppercase tracking-widest">Subject:</span>
                <div class="border-b border-gray-400 flex-grow h-4"></div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-gray-600 uppercase tracking-widest">Exam date:</span>
                <div class="border-b border-gray-400 flex-grow h-4"></div>
            </div>
            <div class="text-right text-xs text-gray-400 font-bold uppercase tracking-wider">getstudynova.online</div>
        </div>
    </div>

    <!-- How to use -->
    <div class="mb-3 bg-gray-50 border border-gray-200 rounded-lg px-4 py-2">
        <p class="text-xs text-gray-600 leading-relaxed"><span class="font-bold text-gray-800 uppercase tracking-wider">How to use:</span> Write the exam date beside Day 0 in your calendar, then count backwards and date each row. Give every day one specific target topic &mdash; &ldquo;equilibrium calculations,&rdquo; not &ldquo;chemistry.&rdquo; Tick the past-paper box only after a timed, closed-book attempt. Circle your confidence honestly: if it is 1&ndash;2, schedule that topic again within 48 hours.</p>
    </div>

    <!-- Countdown table -->
    <table class="w-full border-collapse">
        <thead>
            <tr class="border-y-2 border-gray-800 bg-gray-50">
                <th class="text-center py-1 px-1 text-[10px] font-bold text-gray-800 uppercase tracking-widest w-20">Days Left</th>
                <th class="text-left py-1 px-2 text-[10px] font-bold text-gray-800 uppercase tracking-widest w-20">Date</th>
                <th class="text-left py-1 px-2 text-[10px] font-bold text-gray-800 uppercase tracking-widest">Today&rsquo;s Target Topic</th>
                <th class="text-center py-1 px-1 text-[10px] font-bold text-gray-800 uppercase tracking-widest w-16">Past Paper?</th>
                <th class="text-center py-1 px-1 text-[10px] font-bold text-gray-800 uppercase tracking-widest w-28">Confidence 1&ndash;5</th>
            </tr>
        </thead>
        <tbody>
            {countdownDays.map((day) => (
                <tr class="border-b border-gray-200">
                    <td class="py-[3px] px-1 text-center align-middle">
                        <span class="text-sm font-black text-gray-800">{day}</span>
                        <span class="block text-[7px] font-bold text-gray-400 tracking-widest">{phaseFor(day)}</span>
                    </td>
                    <td class="py-[3px] px-2"><div class="border-b border-dotted border-gray-300 h-4"></div></td>
                    <td class="py-[3px] px-2"><div class="border-b border-dotted border-gray-300 h-4"></div></td>
                    <td class="py-[3px] px-1 text-center"><span class="inline-block w-4 h-4 border-2 border-gray-400 rounded-sm align-middle"></span></td>
                    <td class="py-[3px] px-1 text-center text-[10px] font-bold text-gray-400 tracking-[0.2em]">1&nbsp; 2&nbsp; 3&nbsp; 4&nbsp; 5</td>
                </tr>
            ))}
        </tbody>
    </table>

    <!-- Phase strip -->
    <div class="mt-3 grid grid-cols-5 gap-2 text-center">
        <div class="border border-gray-300 rounded-md px-2 py-2">
            <p class="text-[10px] font-black text-gray-800 uppercase tracking-widest">30&ndash;22: Build</p>
            <p class="text-[9px] text-gray-500 mt-1">Map topics and close knowledge gaps.</p>
        </div>
        <div class="border border-gray-300 rounded-md px-2 py-2">
            <p class="text-[10px] font-black text-gray-800 uppercase tracking-widest">21&ndash;15: Retrieve</p>
            <p class="text-[9px] text-gray-500 mt-1">Closed-book questions every day.</p>
        </div>
        <div class="border border-gray-300 rounded-md px-2 py-2">
            <p class="text-[10px] font-black text-gray-800 uppercase tracking-widest">14&ndash;8: Past Papers</p>
            <p class="text-[9px] text-gray-500 mt-1">Timed practice and strict marking.</p>
        </div>
        <div class="border border-gray-300 rounded-md px-2 py-2">
            <p class="text-[10px] font-black text-gray-800 uppercase tracking-widest">7&ndash;2: Repair</p>
            <p class="text-[9px] text-gray-500 mt-1">Fix repeated errors and weak topics.</p>
        </div>
        <div class="border border-gray-300 rounded-md px-2 py-2">
            <p class="text-[10px] font-black text-gray-800 uppercase tracking-widest">1: Taper</p>
            <p class="text-[9px] text-gray-500 mt-1">Light review, pack, and sleep.</p>
        </div>
    </div>

</PrintableLayout>
